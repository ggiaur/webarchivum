# FEWA V3.1 Environment Configuration Example

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-super-secret-key-32-chars-min
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
# ARCH-01 uses three distinct DB roles (spec/migrations/006_arch_01_db_roles.sql):
#   fewa_bootstrap - one-shot cluster superuser; provisions the other two
#     roles and runs the immutable migration 005, then loses server-file
#     access. Never used by the running application.
#   fewa_migrator  - non-superuser; owns the schema and runs ordinary
#     versioned migrations (infra/migrations/runner.py). Never used by the
#     running application.
#   fewa_app       - non-superuser, least-privilege; the ONLY credential the
#     backend/worker actually connect with. Cannot alter schema, disable
#     triggers, or read server files.
# The variables below (POSTGRES_USER/PASSWORD) are consumed by the backend
# and must be the fewa_app credential. POSTGRES_BOOTSTRAP_PASSWORD,
# POSTGRES_MIGRATOR_PASSWORD and POSTGRES_APP_PASSWORD (used by
# docker-compose.yml to provision all three roles) are set separately, e.g.
# in a local .env file consumed by docker compose itself, never here.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fewa_app
POSTGRES_PASSWORD=fewa_app_password
POSTGRES_DB=fewa_v3
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=20

# ARCH-01 DB role provisioning (docker-compose.yml / infra/postgres/bootstrap_roles.sql only)
POSTGRES_BOOTSTRAP_PASSWORD=change-this-bootstrap-password
POSTGRES_MIGRATOR_PASSWORD=change-this-migrator-password
POSTGRES_APP_PASSWORD=change-this-app-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1

# MinIO S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_WACZ=fewa-wacz
MINIO_SECURE=false

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
